//! Sysconf wrapper for _SC_PRIORITY_SCHEDULING
const SC_PRIORITY_SCHEDULING = _SC_PRIORITY_SCHEDULING;

//! Sysconf wrapper for _SC_TIMERS
const SC_TIMERS = _SC_TIMERS;

//! Sysconf wrapper for _SC_ASYNCHRONOUS_IO
const SC_ASYNCHRONOUS_IO = _SC_ASYNCHRONOUS_IO;

//! Sysconf wrapper for _SC_PRIORITIZED_IO
const SC_PRIORITIZED_IO = _SC_PRIORITIZED_IO;

//! Sysconf wrapper for _SC_SYNCHRONIZED_IO
const SC_SYNCHRONIZED_IO = _SC_SYNCHRONIZED_IO;

//! Sysconf wrapper for _SC_FSYNC
const SC_FSYNC = _SC_FSYNC;

//! Sysconf wrapper for _SC_MAPPED_FILES
const SC_MAPPED_FILES = _SC_MAPPED_FILES;

//! Sysconf wrapper for _SC_MEMLOCK
const SC_MEMLOCK = _SC_MEMLOCK;

//! Sysconf wrapper for _SC_MEMLOCK_RANGE
const SC_MEMLOCK_RANGE = _SC_MEMLOCK_RANGE;

//! Sysconf wrapper for _SC_MEMORY_PROTECTION
const SC_MEMORY_PROTECTION = _SC_MEMORY_PROTECTION;

