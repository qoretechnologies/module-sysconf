set -eu
unset QORE_MODULE_DIR QORE_MODULE_DIR_ONLY QORE_INCLUDE_DIR LD_LIBRARY_PATH LD_PRELOAD
cd "$AUTOPKGTEST_TMP"
cat > sysconf-smoke.q <<'EOF'
%modern
%requires sysconf
if (sysconf(name: Sysconf::SC_PAGESIZE) < 512
        || !confstr(name: Confstr::CS_PATH)
        || pathconf(path: "/tmp", name: Pathconf::PC_NAME_MAX) < 1) {
    exit(1);
}
EOF
/usr/bin/qcc -o sysconf-smoke sysconf-smoke.q
./sysconf-smoke
